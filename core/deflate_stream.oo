// # RFC 1951 Deflate Stream Processor
//
// Logline: Encodes and decodes capability-bounded Deflate streams with block boundary validation.
//
// Setup: Pure byte-stream transformer without external compression dependencies.
//
// Beats:
//   1. Chunk uncompressed input data into RFC 1951 compliant block boundaries.
//   2. Encode Deflate blocks with BFINAL and BTYPE headers and length complement checking.
//   3. Decode Deflate stream blocks, validating LEN and NLEN checksum complements.
//   4. Deliver decoded literal byte streams with zero ambient memory leakage.

pub fn deflate_encode_stored(data: String) -> List[Int] {
    let mut out: List[Int] = bytes_new();
    let total_len: Int = bytes_len(data);

    if total_len == 0 {
        // Single empty final stored block
        out = bytes_push(out, 1);    // BFINAL=1, BTYPE=00
        out = bytes_push(out, 0);    // LEN lo
        out = bytes_push(out, 0);    // LEN hi
        out = bytes_push(out, 255);  // NLEN lo
        out = bytes_push(out, 255);  // NLEN hi
        return out;
    }

    let chunk_limit: Int = 32768;
    let mut offset: Int = 0;

    while offset < total_len {
        let remaining: Int = total_len - offset;
        let chunk_size: Int = if remaining > chunk_limit { chunk_limit } else { remaining };
        let is_last: Bool = (offset + chunk_size >= total_len);

        let header_byte: Int = if is_last { 1 } else { 0 };
        out = bytes_push(out, header_byte);

        let len_lo: Int = chunk_size & 255;
        let len_hi: Int = (chunk_size >> 8) & 255;
        out = bytes_push(out, len_lo);
        out = bytes_push(out, len_hi);

        let nlen: Int = chunk_size ^ 65535;
        let nlen_lo: Int = nlen & 255;
        let nlen_hi: Int = (nlen >> 8) & 255;
        out = bytes_push(out, nlen_lo);
        out = bytes_push(out, nlen_hi);

        let mut i: Int = 0;
        while i < chunk_size {
            let b: Int = byte_at(data, offset + i);
            out = bytes_push(out, b);
            i = i + 1;
        }

        offset = offset + chunk_size;
    }

    return out;
}

pub fn deflate_decode_stream(
    raw: String,
    start_pos: Int,
    payload_len: Int
) -> Result[String, String] {
    let mut out: String = "";
    let mut offset: Int = start_pos;
    let max_pos: Int = start_pos + payload_len;
    let total_raw_len: Int = bytes_len(raw);
    let mut is_final: Bool = false;

    while offset < max_pos && offset < total_raw_len && !is_final {
        let b0: Int = byte_at(raw, offset);
        is_final = (b0 & 1) != 0;
        let btype: Int = (b0 >> 1) & 3;

        if btype == 0 {
            // Stored uncompressed block
            offset = offset + 1;
            if offset + 4 > total_raw_len {
                return Err("Truncated Deflate stored block header");
            }

            let len_lo: Int = byte_at(raw, offset);
            let len_hi: Int = byte_at(raw, offset + 1);
            let block_len: Int = (len_lo & 255) | ((len_hi & 255) << 8);

            let nlen_lo: Int = byte_at(raw, offset + 2);
            let nlen_hi: Int = byte_at(raw, offset + 3);
            let nlen_val: Int = (nlen_lo & 255) | ((nlen_hi & 255) << 8);

            if (block_len ^ 65535) != nlen_val {
                return Err("Deflate block NLEN complement mismatch");
            }

            offset = offset + 4;
            if offset + block_len > total_raw_len {
                return Err("Truncated Deflate stored block payload");
            }

            let mut chunk_bytes: List[Int] = bytes_new();
            let mut bi: Int = 0;
            while bi < block_len {
                chunk_bytes = bytes_push(chunk_bytes, byte_at(raw, offset + bi));
                bi = bi + 1;
            }
            out = out + bytes_to_str(chunk_bytes);
            offset = offset + block_len;
        } else {
            return Err("Unsupported Deflate compression block type: " + btype.to_string());
        }
    }

    return Ok(out);
}
