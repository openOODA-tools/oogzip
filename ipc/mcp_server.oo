// # Model Context Protocol Stdio Server
//
// Logline: Streaming JSON-RPC 2.0 protocol handler providing 5 sovereign gzip compression tools.
//
// Setup: Demands &FsReadCap for reading standard input and executing streaming RPC requests.
//
// Beats:
//   1. Handle JSON-RPC lifecycle methods (initialize, ping, tools/list, shutdown).
//   2. Dispatch tool calls: gzip_compress, gzip_decompress, gzip_inspect, gzip_test, gzip_demo.
//   3. Extract request parameters with RFC 8259 unescaping.
//   4. Format conformant JSON-RPC responses and send to standard output.

import "core/gzip_types.oo";
import "core/crc32_engine.oo";
import "core/gzip_container.oo";
import "core/archive_inspector.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "json_field.oo";

fn mcp_success(id: String, result_json: String) -> String {
    let id_field: String = if chars_len(id) == 0 { "null" } else { id };
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_field + ",\"result\":" + result_json + "}\n";
}

fn mcp_error(id: String, code: Int, msg: String) -> String {
    let id_field: String = if chars_len(id) == 0 { "null" } else { id };
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id_field + ",\"error\":{\"code\":" + code.to_string() + ",\"message\":\"" + json_str_escape(msg) + "\"}}\n";
}

fn handle_tools_list(id: String) -> String {
    let list_json: String = "{\"tools\":["
        + "{\"name\":\"gzip_compress\",\"description\":\"Compress raw text into RFC 1952 gzip archive stream.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\",\"description\":\"Input text to compress.\"},\"filename\":{\"type\":\"string\",\"description\":\"Original filename for header.\"},\"level\":{\"type\":\"integer\",\"description\":\"Compression level 1-9 [default: 6].\"}},\"required\":[\"data\"]}},"
        + "{\"name\":\"gzip_decompress\",\"description\":\"Decompress RFC 1952 gzip archive stream, validating CRC-32 and ISIZE.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"compressed\":{\"type\":\"string\",\"description\":\"Gzip archive stream to decompress.\"}},\"required\":[\"compressed\"]}},"
        + "{\"name\":\"gzip_inspect\",\"description\":\"Parse gzip archive header, compression ratio, timestamp, and trailer fields.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\",\"description\":\"Gzip archive stream to inspect.\"},\"filename\":{\"type\":\"string\",\"description\":\"Filename or label.\"}},\"required\":[\"data\"]}},"
        + "{\"name\":\"gzip_test\",\"description\":\"Test gzip archive integrity without writing uncompressed output.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"data\":{\"type\":\"string\",\"description\":\"Gzip archive stream to test.\"}},\"required\":[\"data\"]}},"
        + "{\"name\":\"gzip_demo\",\"description\":\"Run multi-scenario compression, bitstream dissection, and benchmark showcase.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}"
        + "]}";
    return mcp_success(id, list_json);
}

pub fn handle_mcp_message(raw: String) -> String {
    let method: String = json_extract_str_field(raw, "method");
    let id_str: String = json_extract_str_field(raw, "id");
    let id_val: String = if chars_len(id_str) > 0 { "\"" + id_str + "\"" } else { json_extract_int_field(raw, "id", 1).to_string() };

    if method == "initialize" {
        let init_result: String = "{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oogzip\",\"version\":\"0.2.0\"}}";
        return mcp_success(id_val, init_result);
    }
    if method == "ping" {
        return mcp_success(id_val, "{}");
    }
    if method == "tools/list" {
        return handle_tools_list(id_val);
    }
    if method == "tools/call" {
        let tool_name: String = json_extract_str_field(raw, "name");

        if tool_name == "gzip_compress" {
            let data: String = json_extract_str_field(raw, "data");
            let fname: String = json_extract_str_field(raw, "filename");
            let level: Int = json_extract_int_field(raw, "level", 6);

            let comp_bytes: List[Int] = compress_to_gzip(data, fname, level);
            let comp_str: String = bytes_to_str(comp_bytes);
            let crc_val: Int = compute_crc32(data);
            let crc_hex: String = crc32_to_hex_str(crc_val);

            let orig_sz: Int = chars_len(data);
            let comp_sz: Int = chars_len(comp_str);
            let ratio: Int = if orig_sz > 0 {
                let sav: Int = orig_sz - comp_sz;
                if sav > 0 { (sav * 100) / orig_sz } else { 0 }
            } else { 0 };

            let res_json: String = compression_result_to_json(
                if chars_len(fname) > 0 { fname } else { "stream.gz" },
                orig_sz,
                comp_sz,
                ratio,
                crc_hex
            );
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(res_json) + "\"}]}");
        }

        if tool_name == "gzip_decompress" {
            let comp_data: String = json_extract_str_field(raw, "compressed");
            let decomp_res: Result[String, String] = decompress_gzip_container(comp_data);
            if decomp_res.is_ok() {
                let uncompressed: String = match decomp_res { Ok(s) => s, Err(_) => "" };
                let out_json: String = "{\"status\":\"OK\",\"uncompressed_size\":" + chars_len(uncompressed).to_string() + ",\"content\":\"" + json_str_escape(uncompressed) + "\"}";
                return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(out_json) + "\"}]}");
            } else {
                let err_msg: String = match decomp_res { Ok(_) => "", Err(e) => e };
                return mcp_error(id_val, -32000, "Decompression failed: " + err_msg);
            }
        }

        if tool_name == "gzip_inspect" {
            let data: String = json_extract_str_field(raw, "data");
            let fname: String = json_extract_str_field(raw, "filename");
            let meta: GzipMetadata = inspect_gzip_stream(data, if chars_len(fname) > 0 { fname } else { "input.gz" });
            let meta_json: String = metadata_to_json(meta);
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(meta_json) + "\"}]}");
        }

        if tool_name == "gzip_test" {
            let data: String = json_extract_str_field(raw, "data");
            let decomp_res: Result[String, String] = decompress_gzip_container(data);
            let ok: Bool = decomp_res.is_ok();
            let err_msg: String = if ok { "Integrity verified (CRC32 and ISIZE match)" } else { match decomp_res { Ok(_) => "", Err(e) => e } };
            let test_json: String = "{\"valid\":" + (if ok { "true" } else { "false" }) + ",\"message\":\"" + json_str_escape(err_msg) + "\"}";
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(test_json) + "\"}]}");
        }

        if tool_name == "gzip_demo" {
            let demo_txt: String = render_gzip_demo(false);
            return mcp_success(id_val, "{\"content\":[{\"type\":\"text\",\"text\":\"" + json_str_escape(demo_txt) + "\"}]}");
        }

        return mcp_error(id_val, -32601, "Unknown tool: " + tool_name);
    }

    if method == "exit" {
        return "";
    }

    return mcp_error(id_val, -32601, "Method not found: " + method);
}

fn find_newline_pos(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn run_mcp_server(fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;

    while running {
        let r: Result[String, String] = oo_read_stdin_chunk(fs, 4096);
        if !r.is_ok() {
            running = false;
        } else {
            let chunk: String = match r { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
                let mut nl_pos: Int = find_newline_pos(buf);
                while nl_pos >= 0 {
                    let line: String = str_slice(buf, 0, nl_pos);
                    buf = str_slice(buf, nl_pos + 1, chars_len(buf));
                    let trimmed: String = str_trim(line);
                    if chars_len(trimmed) > 0 {
                        let resp: String = handle_mcp_message(trimmed);
                        if chars_len(resp) > 0 {
                            print(resp);
                        }
                    }
                    nl_pos = find_newline_pos(buf);
                }
            }
        }
    }
    return 0;
}
