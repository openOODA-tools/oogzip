# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oogzip-bin
_pkgname=oogzip
pkgver=0.2.0
pkgrel=1
pkgdesc="High-speed multi-threaded DEFLATE compression engine with stream headers."
arch=('x86_64')
url="https://github.com/openOODA-tools/oogzip"
license=('Apache-2.0')
depends=('glibc')
provides=('oogzip')
conflicts=('oogzip')
source_x86_64=("${url}/releases/download/v${pkgver}/oogzip-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oogzip-linux-x86_64" "${pkgdir}/usr/bin/oogzip"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oogzip-uninstall"
}
